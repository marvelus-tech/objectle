{
  "name": "objectle-worker-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "THEATER_ROOMS",
        "class_name": "TheaterRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TheaterRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "objectle-db",
      "database_id": "3fbf385e-1743-4c30-82de-b857725e78b0"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
